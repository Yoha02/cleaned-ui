# Aprilio.ai Environment Variables

# Site
SITE_URL=https://aprilio.ai

# Research-site experiment
# true = research-first site entry and research navigation
# false = classic product landing page
# Cloud Build sets this explicitly as a Docker build argument.
NEXT_PUBLIC_RESEARCH_LANDING=false

# Blog Agent Pipeline (Phase 2)
ANTHROPIC_API_KEY=
PUBMED_API_KEY=
FDA_API_KEY=

# Notifications
SLACK_WEBHOOK_URL=

# Google Cloud
GCP_PROJECT_ID=
FIRESTORE_COLLECTION=articles

# Admin
ADMIN_PASSWORD=
